# PHPStan over the hand-written examples in examples/php (P44EUyV6) — a CI GATE
# (validate-php, "PHPStan over examples/php"). Unlike phpstan.neon (src + parity,
# reported, not gated) this has NO baseline and NO ignore list: a broken example
# must fail, not be absorbed.
#
# LEVEL 8 (93b8346T): the examples were fixed to pass it, so an unknown INSTANCE
# method on the fluent chain (->compresss()) fails here, not only unknown classes,
# functions and static methods. treatPhpDocTypesAsCertain stays false: generated
# docblocks are not always true at runtime (see 17-list-workflows.php).
parameters:
    level: 8
    paths:
        - ../../examples/php
    treatPhpDocTypesAsCertain: false
